{
  "title": "Aromatic Light Norwegian Lamb Stew",
  "description": "A keto-friendly and umami-rich lamb stew featuring sage and braised to perfection, perfect for a post-workout dinner",
  "cuisine": "Norwegian",
  "diet": [
    "keto",
    "low-carb",
