  "instructions": [
    "Heat ghee in a large pan over medium heat.",
    "Add onion, ginger, and garlic; cook until onion is translucent.",
    "Add chickpeas, chana masala spice mix, turmeric, cumin, coriander, and celery salt; cook for 1 minute.",
    "Add crushed tomatoes and 1 cup of water; bring to a boil.",
    "Reduce heat to low and simmer for 20 minutes.",
    "Stir in beurre-monte and ghee.",
    "Season with salt to taste.",
    "Serve hot garnished with fresh cilantro."
