    {
      "name": "ssam-wrap",
      "amount": "4 sheets",
      "notes": "low-carb wrap"
    },
    {
      "name": "granny smith apples",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "allspice",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
