      "name": "cinnamon",
      "amount": "1/2 teaspoon",
      "notes": "ground"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons",
      "notes": "pure"
    },
    {
      "name": "almond butter",
      "amount": "2 tablespoons",
      "notes": "creamy"
    },
    {
      "name": "raisins",
      "amount": "1/4 cup",
      "notes": "dark"
    },
    {
      "name": "walnuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat a non-stick pan over medium heat",
    "In a bowl, mix together sliced apples, allspice, and cinnamon",
    "Add honey and almond butter to the bowl and mix until well combined",
    "Arrange a ssam-wrap sheet on a flat surface",
    "Spoon the apple mixture onto the center of the wrap",
    "Sprinkle raisins and walnuts over the apple mixture",
    "Fold the bottom half of the wrap up over the filling",
    "Fold in the sides and roll the wrap up tightly",
    "Cook the wrap in the preheated pan for 2-3 minutes on each side",
    "Serve warm and enjoy"
  ],
