      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in the clay pot tagliere over medium heat.",
    "Add the onion and garlic and saute until the onion is translucent.",
    "Add the goat meat and cook until browned on all sides.",
    "Add the sumac, thyme, scotch bonnet pepper, potato, and carrot, and stir to combine.",
    "Pour in the beef broth and bring the stew to a boil.",
    "Reduce the heat to low and simmer, covered, for 1 1/2 hours, or until the meat is tender.",
    "Season the stew with salt and pepper to taste.",
    "Serve the stew hot, garnished with fresh herbs if desired."
  ],
