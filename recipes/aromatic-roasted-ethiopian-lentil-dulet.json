{
  "title": "Aromatic Roasted Ethiopian Lentil Dulet",
  "description": "A hearty and comforting Ethiopian dish made with roasted lentils and aromatic spices, perfect for a lazy Sunday",
  "cuisine": "Ethiopian",
  "diet": [
    "macrobiotic",
    "vegetarian"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "brown lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "cinnamon stick",
      "amount": "1",
      "notes": "broken into pieces"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a large bowl, mix together the lentils, onion, carrot, cinnamon stick, garlic, salt, and black pepper",
    "Drizzle the olive oil over the mixture and stir to combine",
    "Transfer the mixture to a large mason jar and add the water",
    "Cover the mason jar with a lid and place it in the oven",
    "Roast for 45 minutes, or until the lentils are tender",
    "Remove the mason jar from the oven and let it cool slightly",
    "Serve the dulet hot, garnished with chopped fresh herbs if desired"
  ],
