      "name": "cream cheese",
      "amount": "8 ounces",
      "notes": "softened"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the robata-grill to 375 degrees Fahrenheit.",
    "In a large bowl, mix together the softened cream cheese, crumbly feta cheese, black pepper, salt, garlic powder, and paprika until well combined.",
    "Thread the cheese mixture onto skewers, leaving a small space between each piece.",
    "Brush the cheese skewers with olive oil.",
    "Grill the cheese skewers on the robata-grill for 5-7 minutes per side, or until lightly browned.",
    "Garnish with chopped fresh parsley.",
    "Serve immediately and enjoy.",
    "Repeat the process until all the cheese mixture is used up."
  ],
