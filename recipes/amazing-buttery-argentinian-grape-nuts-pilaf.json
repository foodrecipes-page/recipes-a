    {
      "name": "Grape Nuts cereal",
      "amount": "2 cups",
      "notes": "crushed"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Argentinian chimichurri sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "grated cheddar cheese",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the melted butter in a large wok over medium heat.",
    "Add the chopped onion and cook until translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the crushed Grape Nuts cereal and cook for 2 minutes, stirring constantly.",
    "Add the Argentinian chimichurri sauce and stir to combine.",
    "Pour in the heavy cream and bring to a simmer.",
    "Reduce the heat to low and stir in the grated cheddar cheese until melted.",
    "Season with salt and black pepper to taste.",
    "Spoon the pilaf into scallop shells and serve immediately."
  ],
