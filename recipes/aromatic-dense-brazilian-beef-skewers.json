    {
      "name": "beef sirloin",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "black cardamom pods",
      "amount": "4 pods",
      "notes": "crushed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for brushing"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "In a large bowl, combine beef, crushed black cardamom pods, garlic, ginger, cumin, smoked paprika, salt, and black pepper",
    "Mix well to combine, making sure the beef is evenly coated",
    "Thread the beef mixture onto skewers, leaving a small space between each piece",
    "Brush the skewers with olive oil",
    "Grill the skewers for 8-10 minutes, turning occasionally, or until the beef reaches an internal temperature of 130 degrees",
    "Let the skewers rest for 5 minutes before serving",
    "Serve hot, garnished with fresh cilantro if desired"
  ],
