{
  "title": "Aromatic Garlicky Brazilian Chicken Skewers",
  "description": "A garlicky and snappy post-workout Brazilian dish featuring chicken stock cube and caramelized onions, made with ayurvedic-sattvic-friendly ingredients",
  "cuisine": "Brazilian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
