  "ingredients": [
    {
      "name": "rice stick noodles",
      "amount": "8 oz",
      "notes": "cooked according to package instructions"
    },
    {
      "name": "papillote",
      "amount": "2 cups",
      "notes": "dried and rehydrated"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "turmeric",
      "amount": "1 tsp"
    },
    {
      "name": "ginger",
      "amount": "1 tsp",
      "notes": "grated"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the turmeric, ginger, salt, and black pepper, and stir to combine.",
    "Add the rehydrated papillote and cook for 2 minutes, stirring constantly.",
    "Add the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let cook for 10 minutes, stirring occasionally.",
    "Add the cooked rice stick noodles to the saucepan and stir to combine.",
    "Serve the noodle dish hot on a wooden board, garnished with additional papillote if desired."
  ],
