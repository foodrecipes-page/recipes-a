{
  "title": "Aromatic Algerian Noodle Dish",
  "description": "A sweet and creamy Algerian dish featuring rice stick noodles and papillote, made with anti-inflammatory friendly ingredients, served on a wooden board.",
  "cuisine": "Algerian",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
