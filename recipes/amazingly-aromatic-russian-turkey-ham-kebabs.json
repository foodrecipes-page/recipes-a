  "instructions": [
    "Preheat the tandoor to 400 degrees Fahrenheit",
    "Thread the diced turkey ham, onion, and bell pepper onto skewers",
    "In a small bowl, whisk together olive oil, lemon juice, garlic, paprika, salt, and black pepper",
    "Brush the mixture onto the skewers",
    "Place the skewers in the tandoor and cook for 15 minutes",
    "Turn the skewers and cook for an additional 10 minutes",
    "Remove the skewers from the tandoor and let rest for 5 minutes",
    "Serve hot and enjoy"
  ],
