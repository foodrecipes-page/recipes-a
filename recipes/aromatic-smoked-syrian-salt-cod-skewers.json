      "name": "salt cod",
      "amount": "1 pound",
      "notes": "dried and soaked overnight"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "sumac",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cedar planks",
      "amount": "4 pieces",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "Soak the cedar planks in water for 30 minutes before grilling.",
    "Cut the salt cod into 1-inch pieces and thread onto skewers.",
    "Mix the olive oil, lemon juice, garlic, smoked paprika, sumac, and black pepper in a bowl.",
    "Brush the mixture onto the salt cod skewers.",
    "Place the skewers on the cedar planks and grill for 8 minutes per side.",
    "Serve the skewers hot, garnished with chopped parsley.",
    "Let the skewers rest for 2 minutes before serving."
  ],
