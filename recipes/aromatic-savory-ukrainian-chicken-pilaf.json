{
  "title": "Aromatic Savory Ukrainian Chicken Pilaf",
  "description": "Rich and festive Ukrainian dish featuring rice wine and kombu cold extract, perfect for special occasions, this recipe is onion and garlic free.",
  "cuisine": "Ukrainian",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "uncooked white rice",
      "amount": "2 cups"
    },
    {
      "name": "rice wine",
      "amount": "1 cup"
    },
    {
      "name": "kombu cold extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and grated"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium high heat.",
    "Add the chicken to the skillet and cook until browned, about 5 minutes.",
    "Add the carrots and mushrooms to the skillet and cook until the vegetables are tender.",
    "Add the rice to the skillet and cook for 1 minute, stirring constantly.",
    "Add the rice wine, kombu cold extract, chicken broth, thyme, salt, and pepper to the skillet and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low, cover, and simmer for 20 minutes.",
    "Fluff the pilaf with a fork and serve hot.",
    "Garnish with fresh herbs, if desired.",
    "Serve immediately and enjoy.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
