{
  "title": "Aromatic Crisp Algerian Lamb Kebabs",
  "description": "A salty and crisp Algerian dish featuring ground ginger and shio-koji-cure, perfect for a quick fix meal, paleo-friendly and full of flavor.",
  "cuisine": "Algerian",
  "diet": [
    "paleo"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "ground lamb",
      "amount": "1 pound",
      "notes": "preferably grass fed"
    },
    {
      "name": "ground ginger",
      "amount": "2 tablespoons"
    },
    {
      "name": "shio-koji",
      "amount": "1 tablespoon"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "In a large bowl, combine the ground lamb, ground ginger, shio-koji, paprika, salt, and black pepper.",
    "Mix well with your hands or a wooden spoon until just combined.",
    "Mince the onion and garlic, then add to the bowl and mix again until just combined.",
    "Thread the lamb mixture onto skewers, leaving a small space between each piece.",
    "Brush the skewers with olive oil.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until cooked through and slightly charred.",
    "Let the kebabs rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
