      "name": "bananas",
      "amount": "4",
      "notes": "ripe but firm"
    },
    {
      "name": "pita bread",
      "amount": "1 cup",
      "notes": "crushed into crumbs"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/4 cup",
      "notes": "canned, drained, and chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Cut the bananas into 1-inch pieces and set aside",
    "In a bowl, mix together the crushed pita bread, crumbly feta cheese, chopped kalamata olives, and chopped artichoke hearts",
    "Thread a banana piece onto a skewer, followed by a spoonful of the pita bread mixture, and repeat until the skewer is full",
    "Drizzle the lemon juice and olive oil over the skewers",
    "Sprinkle the salt and pepper over the skewers",
    "Place the skewers on a baking sheet lined with parchment paper and bake for 12 minutes",
    "Remove the skewers from the oven and let cool for a few minutes before serving"
  ],
