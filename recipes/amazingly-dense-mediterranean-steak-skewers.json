      "name": "sirloin steak tips",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "oregano",
      "amount": "1 teaspoon",
      "notes": "dried"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "zucchini",
      "amount": "1 medium",
      "notes": "cut into 1-inch slices"
    },
    {
      "name": "red onion",
      "amount": "1 medium",
      "notes": "cut into 1-inch pieces"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, oregano, salt, and pepper.",
    "Add the steak tips to the bowl and toss to coat with the marinade.",
    "Thread the steak tips, zucchini, and red onion onto skewers.",
    "Grill the skewers for 10-12 minutes, turning occasionally, or until the steak reaches an internal temperature of 135 degrees Fahrenheit.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve hot and enjoy.",
    "Garnish with fresh parsley or oregano, if desired."
