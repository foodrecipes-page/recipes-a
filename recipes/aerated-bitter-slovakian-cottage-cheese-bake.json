{
  "title": "Aerated Bitter Slovakian Cottage Cheese Bake",
  "description": "A unique brunch dish featuring cottage cheese, perfect for a slovakian-inspired meal. This aerated batter adds a light and fluffy texture.",
  "cuisine": "slovakian",
  "diet": [
    "flexitarian",
    "vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
