      "name": "cottage cheese",
      "amount": "250g",
      "notes": ""
    },
    {
      "name": "all-purpose flour",
      "amount": "150g",
      "notes": ""
    },
    {
      "name": "sugar",
      "amount": "2 tablespoons",
      "notes": ""
    },
    {
      "name": "unsalted butter",
      "amount": "1 tablespoon",
      "notes": ""
    },
    {
      "name": "large eggs",
      "amount": "2",
      "notes": ""
    },
    {
      "name": "grated cheddar cheese",
      "amount": "50g",
      "notes": ""
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon",
      "notes": ""
    },
    {
