{
  "title": "Amazingly Crunchy Portuguese Peppers Skewers",
  "description": "A quick and easy Portuguese dish featuring sweet peppadew peppers with a crunchy lacquer glaze, perfect for a low calorie snack or appetizer.",
  "cuisine": "Portuguese",
  "diet": [
    "low-calorie",
