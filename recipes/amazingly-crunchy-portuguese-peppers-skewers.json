      "amount": "1/4 cup"
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp"
    },
    {
      "name": "paprika",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "honey",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Thread the peppadew peppers onto skewers.",
    "In a small bowl, whisk together the olive oil, garlic powder, paprika, salt, and black pepper.",
    "Brush the mixture onto the peppers.",
    "Bake the peppers for 15 minutes.",
    "While the peppers are baking, mix the lemon juice and honey in a small bowl.",
    "After the peppers have baked for 15 minutes, brush the lacquer glaze onto the peppers.",
    "Return the peppers to the oven and bake for an additional 5 minutes.",
    "Remove the peppers from the oven and let them cool for a few minutes before serving."
  ],
