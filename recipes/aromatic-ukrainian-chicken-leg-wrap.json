      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit.",
    "In a large bowl, mix together melted butter, chopped onion, minced garlic, smoked paprika, salt, and black pepper.",
    "Add the chicken legs to the bowl and toss to coat evenly with the butter mixture.",
    "Wrap each chicken leg in a corn husk, making sure to seal the edges.",
    "Place the wrapped chicken legs on a baking sheet lined with parchment paper.",
    "Bake for 30 minutes or until the chicken is cooked through and the corn husks are crispy.",
    "Remove from oven and let rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
