{
  "title": "Aromatic Ukrainian Chicken Leg Wrap",
  "description": "A buttery and crumbly Ukrainian dish featuring chicken legs wrapped in a corn husk, perfect for a comforting meal. This recipe is dairy-free-friendly.",
  "cuisine": "Ukrainian",
  "diet": [],
  "meal": "dinner",
