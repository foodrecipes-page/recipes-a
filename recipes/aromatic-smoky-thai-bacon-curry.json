      "amount": "1 teaspoon"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "Thai basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat a hot pot vessel over medium heat and add the streaky bacon to cook until crispy",
    "Remove the cooked bacon from the vessel and set aside",
    "Add the diced onion, carrot, and celery to the vessel and cook until the vegetables are tender",
    "Add the Thai red curry paste to the vessel and cook for 1 minute, stirring constantly",
    "Pour in the coconut milk and bring the mixture to a simmer",
    "Add the fish sauce, brown sugar, and lime juice to the vessel and stir to combine",
    "Add the cooked bacon back to the vessel and stir to combine",
    "Reduce the heat to low and let the curry simmer for 10 minutes",
    "Stir in the chopped Thai basil and serve the curry hot"
  ],
