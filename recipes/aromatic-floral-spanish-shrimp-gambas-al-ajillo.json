  "ingredients": [
    {
      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "quinoa",
      "amount": "1 cup",
      "notes": "rinsed"
    },
    {
      "name": "kombu-cold-extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "dried rose petals",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Rinse the quinoa in a fine mesh strainer and cook according to package instructions.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the shrimp and cook for 2-3 minutes per side, until pink and fully cooked.",
    "In a small bowl, whisk together the kombu-cold-extract, lemon juice, dried rose petals, salt, and black pepper.",
    "Pour the sauce over the cooked shrimp and stir to combine.",
    "Fluff the cooked quinoa with a fork and serve alongside the shrimp.",
    "Garnish with additional dried rose petals, if desired."
  ],
