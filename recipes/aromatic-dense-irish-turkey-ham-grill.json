      "name": "turkey ham",
      "amount": "1 pound",
      "notes": "sliced into 1/2 inch thick pieces"
    },
    {
      "name": "fresh thyme",
      "amount": "2 tablespoons",
      "notes": "chopped"
    },
    {
      "name": "fresh rosemary",
      "amount": "1 tablespoon",
      "notes": "chopped"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the grill to 375 degrees Fahrenheit.",
    "In a small bowl, mix together thyme, rosemary, garlic powder, onion powder, salt, and pepper.",
    "Brush the turkey ham slices with olive oil and sprinkle with the herbal mixture.",
    "Place the turkey ham slices on the grill and cook for 5 minutes per side, or until the internal temperature reaches 165 degrees Fahrenheit.",
    "Remove the turkey ham from the grill and let it rest for 5 minutes before slicing.",
    "Serve the sliced turkey ham hot, garnished with additional thyme and rosemary if desired."
  ],
