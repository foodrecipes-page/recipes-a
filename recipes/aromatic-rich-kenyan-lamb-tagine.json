    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for cooking"
    }
  ],
  "instructions": [
    "Heat the olive oil in the tagine pot over medium heat.",
    "Add the onion and cook until it is translucent and starting to caramelize.",
    "Add the garlic and ginger and cook for 1 minute, stirring constantly.",
    "Add the lamb and cook until it is browned on all sides.",
    "Add the cumin, coriander, cayenne pepper, salt, and black pepper, and stir to combine.",
    "Add the makrut lime leaves and stir to combine.",
    "Cover the tagine pot and bring the mixture to a simmer.",
    "Reduce the heat to low and cook, covered, for 2 1/2 hours, or until the lamb is tender.",
    "Remove the tagine pot from the heat and let it cool slightly.",
    "Serve the lamb and sauce over rice or with naan bread."
  ],
