      "amount": "1/4 cup",
      "notes": ""
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": ""
    },
    {
      "name": "puff pastry",
      "amount": "1 sheet",
      "notes": "thawed"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees.",
    "Roll out the puff pastry and place it on a baking sheet.",
    "Mix the sliced almonds, minced garlic, salt, and black pepper in a bowl.",
    "Spread the almond mixture evenly over the puff pastry, leaving a 1 inch border.",
    "Drizzle the olive oil over the almond mixture.",
    "Squeeze the lemon juice over the top.",
    "Poach the eggs and place them on top of the tart.",
    "Bake the tart for 25 minutes or until the pastry is golden brown.",
    "Remove the tart from the oven and let it cool for 5 minutes.",
    "Slice the tart into 8 pieces and serve."
  ],
