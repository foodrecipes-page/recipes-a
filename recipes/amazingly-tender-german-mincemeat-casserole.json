{
  "title": "Amazingly Tender German Mincemeat Casserole",
  "description": "A comforting German dish featuring mincemeat, tadka, and pescatarian-friendly ingredients, resulting in a jammy and tender casserole.",
  "cuisine": "German",
  "diet": [
    "pescatarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "mincemeat",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "onions",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "tadka spice blend",
      "amount": "2 tablespoons",
      "notes": "store-bought or homemade"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons",
      "notes": "melted"
    },
    {
      "name": "all-purpose flour",
      "amount": "1 cup",
      "notes": "for thickening"
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "whole or 2%"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large pan, saute the chopped onions and carrots in melted butter until tender.",
    "Add the chopped potatoes, cod fillets, tadka spice blend, salt, and black pepper to the pan and stir to combine.",
    "In a separate bowl, whisk together the flour and milk to make a thickening agent.",
    "Add the mincemeat and flour mixture to the pan and stir to combine.",
    "Transfer the mixture to a 9x13 inch baking dish and cover with aluminum foil.",
    "Bake for 30 minutes, then remove the foil and continue baking for an additional 20 minutes.",
    "Remove the casserole from the oven and let it cool for 10 minutes before serving.",
    "Serve hot and enjoy."
  ],
