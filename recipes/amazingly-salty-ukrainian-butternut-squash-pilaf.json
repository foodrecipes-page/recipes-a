{
  "title": "Ukrainian Butternut Squash Pilaf",
  "description": "A salty and kid-friendly Ukrainian dish featuring butternut squash, this pilaf is a great option for a weeknight dinner. The katsuramuki-cut squash adds a nice texture to the dish.",
  "cuisine": "Ukrainian",
  "diet": [
    "plant-based"
  ],
  "meal": "dinner",
  "ingredients": [
