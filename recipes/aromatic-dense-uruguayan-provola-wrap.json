    },
    {
      "name": "thyme",
      "amount": "1 tsp",
      "notes": "fresh"
    },
    {
      "name": "lotus leaves",
      "amount": "4",
      "notes": "fresh"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Preheat a grill or grill pan to medium-high heat.",
    "In a small bowl, mix together olive oil, garlic, oregano, thyme, salt, and black pepper.",
    "Brush the mixture onto both sides of the provola cheese slices.",
    "Grill the provola cheese for 2-3 minutes per side, or until slightly melted and crispy.",
    "Meanwhile, prepare the lotus leaves by rinsing them with water and patting them dry.",
    "To assemble the wraps, place a grilled provola cheese slice onto the center of a lotus leaf.",
    "Fold the lotus leaf over the cheese to form a wrap, and serve immediately.",
    "Repeat with the remaining ingredients."
  ],
