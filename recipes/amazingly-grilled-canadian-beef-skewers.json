      "name": "Canadian beef",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "Dutch stroop",
      "amount": "1/4 cup"
    },
    {
      "name": "Olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Garlic infused oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the yakimono grill to 400 degrees Fahrenheit.",
    "Thread the beef cubes onto skewers, leaving a small space between each piece.",
    "Brush the beef with olive oil and garlic infused oil.",
    "Season with salt and black pepper.",
    "Grill the skewers for 10 minutes, turning occasionally.",
    "Brush the dutch stroop onto the beef during the last 2 minutes of grilling.",
    "Remove from heat and garnish with chopped parsley.",
    "Serve immediately.",
    "Let rest for 5 minutes before serving."
  ],
