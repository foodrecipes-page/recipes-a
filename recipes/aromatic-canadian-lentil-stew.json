{
  "title": "Aromatic Canadian Lentil Stew",
  "description": "A hearty and flavorful vegan-friendly stew featuring mustard seeds and lardons-render, perfect for a weeknight dinner",
  "cuisine": "Canadian",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "green lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "mustard seeds",
      "amount": "2 tablespoons"
    },
    {
      "name": "lardons-render",
      "amount": "1/4 cup",
      "notes": "vegan alternative to bacon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "In a large pot, heat the lardons-render over medium heat until crispy",
    "Add the mustard seeds and cook for 1 minute, until fragrant",
    "Add the chopped onion, carrots, and celery, and cook until the vegetables are tender",
    "Add the green lentils, vegetable broth, and tomato paste, and bring to a boil",
    "Reduce the heat to low and simmer for 30 minutes, until the lentils are tender",
    "Season with salt and pepper to taste",
    "Ladle the stew into mason jars and serve hot"
  ],
