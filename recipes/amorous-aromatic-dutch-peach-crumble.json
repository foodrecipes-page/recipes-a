{
  "title": "Amorous Aromatic Dutch Peach Crumble",
  "description": "A romantic Dutch dessert featuring peaches, soffritto-base, and anti-inflammatory friendly ingredients, with a winey and gooey texture.",
  "cuisine": "Dutch",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
