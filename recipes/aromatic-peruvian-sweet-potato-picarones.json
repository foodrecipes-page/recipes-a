{
  "title": "Aromatic Peruvian Sweet Potato Picarones",
  "description": "These jammy, fluffy picarones are a macrobiotic-friendly weeknight dish featuring stracciatella-cheese and sweet potato.",
  "cuisine": "Peruvian",
  "diet": null,
  "meal": "dessert",
  "ingredients": [
    {
      "name": "sweet potatoes",
      "amount": 2
    },
    {
      "name": "stracciatella cheese",
      "amount": "80g"
    },
    {
      "name": "all-purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "baking powder",
      "amount": "1 tsp"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tbsp"
    },
    {
      "name": "olive oil",
      "amount": "1 tbsp"
    },
    {
      "name": "sugar",
      "amount": "2 tbsp"
    },
    {
      "name": "vanilla extract",
      "amount": "1 tsp"
    },
    {
      "name": "milk or water",
      "amount": "400ml"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F.",
    "Grate sweet potatoes and mix with stracciatella cheese.",
    "In a separate bowl, whisk together flour, baking powder, butter, olive oil, sugar, and vanilla extract.",
    "Add wet ingredients to dry in a large mixing bowl, stirring until smooth.",
    "Heat milk or water over medium heat. Add to batter and stir until well combined.",
    "Pour batter into greased muffin tins, filling each about 3/4 full.",
    "Bake for 20-25 minutes or until golden brown on top and a toothpick inserted comes out clean.",
    "Let cool before serving."
  ],
