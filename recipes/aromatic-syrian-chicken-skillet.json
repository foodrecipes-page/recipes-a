      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium-high heat.",
    "Add the chicken thighs to the skillet and cook until browned on both sides and cooked through.",
    "Remove the chicken from the skillet and set aside.",
    "Add the chopped onion to the skillet and cook until softened.",
    "Add the minced garlic to the skillet and cook for 1 minute.",
    "Add the chopped tomatoes, salt, black pepper, sumac, and paprika to the skillet and cook for 10 minutes.",
    "Return the chicken to the skillet and stir to combine with the tomato mixture.",
    "Reduce heat to low and simmer for 5 minutes.",
    "Stir in the chopped parsley and serve hot."
  ],
