  "instructions": [
    "Heat ghee in a large pan over medium heat.",
    "Add onion and cook until softened, about 5 minutes.",
    "Add ginger and garlic and cook for another minute.",
    "Add cumin powder, coriander powder, turmeric powder, and red chili powder. Cook for 1 minute.",
    "Add lamb pieces and cook until browned, about 5-7 minutes.",
    "Add 2 cups of water and bring to a boil.",
    "Reduce heat to low and simmer, covered, for 1 1/2 hours.",
