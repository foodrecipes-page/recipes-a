    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "1. Preheat the casserole to 300°F (150°C).",
    "2. In a large bowl, combine chicken, sautéed aromatics, and Saudi spices. Mix well.",
    "3. Pour the chicken broth into the casserole, followed by the mixed chicken.",
    "4. Cover the casserole and cook for 2 hours, or until the chicken is tender.",
    "5. Stir in the funky yogurt and cook for an additional 10 minutes.",
    "6. Season with salt and pepper to taste.",
    "7. Garnish with chopped cilantro and serve hot."
